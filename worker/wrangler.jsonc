{
  "name": "flashcard-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "vars": { "GEMINI_MODEL": "gemini-3.5-flash-lite", "GROQ_MODEL": "openai/gpt-oss-120b" },
  "placement": { "region": "aws:ap-southeast-1" },
  "ratelimits": [{ "name": "AI_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
